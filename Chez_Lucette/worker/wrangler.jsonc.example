{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restaurant-menu-publisher",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "vars": {
    "GITHUB_OWNER": "maaxxe",
    "GITHUB_REPO": "restaurant-nom",
    "GITHUB_BRANCH": "main",
    "ALLOWED_ORIGIN": "https://maaxxe.github.io"
  },
  "secrets": {
    "required": ["GITHUB_TOKEN", "ADMIN_PASSWORD"]
  }
}
